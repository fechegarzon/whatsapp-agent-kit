# Copy to .env and fill in. Never commit the real file.

PORT=3000

# From your Meta app: App settings > Basic > App secret.
# Used to check the X-Hub-Signature-256 header on every webhook.
WHATSAPP_APP_SECRET=replace-me

# Any string you choose. Paste the same value in the Meta webhook setup screen.
WHATSAPP_VERIFY_TOKEN=replace-me

# Only needed when DRY_RUN=false.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0

# Safety switches. The defaults are the safe ones.
AGENT_ENABLED=false
DRY_RUN=true

# Comma-separated wa_ids (digits only). When set, the bot can only send to these numbers.
OUTBOUND_ALLOWLIST=

# Optional. If set, the Claude agent replaces the FAQ demo agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

LOG_LEVEL=info
